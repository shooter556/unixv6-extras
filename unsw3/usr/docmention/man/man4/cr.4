	'8','`',':','#','@','\'','=','"',	/*	8	*/
	'9',inv,inv,inv,inv,inv,inv,inv,	/*	9	*/
	inv,inv,inv,inv,inv,inv,inv,cntrl/r,	/*      9 8	*/
	'0','/','s','t','u','v','w','x',	/*    0		*/
	'y','^','\\',',','%','_','>','?',	/*    0   8	*/
	'z',inv,inv,inv,inv,inv,inv,inv,	/*    0 9	*/
	inv,inv,inv,inv,inv,inv,inv,inv,	/*    0 9 8	*/
	'-','j','k','l','m','n','o','p',	/* 11		*/
