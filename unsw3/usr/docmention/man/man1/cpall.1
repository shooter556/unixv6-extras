.th CPALL I 1/1/76
.sh NAME
cpall \*- copy files to a directory
.sh SYNOPSIS
.bd cpall
[ \fB-\fR ]
file ... directory
.sh DESCRIPTION
.it Cpall
repeatedly exec's "/bin/cp" to copy each given
file to the given directory under
the same name.
.sh "SEE ALSO"
cp (I), copy (I), mv (I), mvall (I)
.sh BUGS
