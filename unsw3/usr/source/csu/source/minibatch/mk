: loop
if $1x = x exit
if $1 = all goto all
echo "-->" $1
cc -O -s $1.c; cp a.out $1; rm a.out
shift
goto loop
:
: all
:
echo "--> crd"
cc -O -s crd.c; cp a.out crd; rm a.out
