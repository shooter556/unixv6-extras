	.title	space war
	.enabl	ama
	.mcall	gtsym$
	.list	me
	.macro	div32,rx,ry
	asr	rx
	ror	ry
	asr	rx
	ror	ry
	asr	rx
	ror	ry
	asr	rx
	ror	ry
	.endm
	.macro	mul32,rx,ry
	asl	ry
	rol	rx
	asl	ry
	rol	rx
	asr	ry
	rol	rx
	asr	ry
	rol	rx
	asr	ry
	rol	rx
	.endm
	.nlist	me
	gtsym$

midlx	=	1000
midly	=	0600

ticks	=	50.	;clock ticks/second

;
; dataaq	active body count?
; dataaz	player #1 dfile
; subaaa	tstpri/tstbrx?
;
zero	=	.
;
;
jmp	start
;
;

pwrvec	=	024

.=	zero+1000

stack	=	.

start:	jmp	go
gent:	.word	1		;if nonzero then gentleman's rules
sunmas:	.word	72000		;sun's mass (gravitational field)
thrust:	.word	77000		;total rocket thrust factor
omega:	.word	1600		;delta turn angle
databe:	.word	74000
	1000
sunrad:	.word	4		;sun's radius (for collision sensing)
gogo:	reset
	mov	#stack,sp
	mov	#gogo,@#pwrvec
	mov	#br7,@#pwrvec+2
	clr	@#ps
	mov	#6,comets	;;comets??
	mov	comets,gents
	mov	#3,r5		;;players???
	mov	r5,ships	;player count
	mov	#dlist,r0
	mov	#dataaz,r1
10$:	mov	#djmp,(r0)+
	mov	r1,(r0)+
	add	#10,r1
	mov	#<"  >,(r1)+	;initialize players score
	mov	#<"  >,(r1)+
	mov	#<" 0>,(r1)+
	add	#22,r1
	mov	r0,(r1)		;connect up djmp
	add	#26,r1
	clr	(r1)		;clear out score
	add	#160,r1		;next player
	dec	r5
	bgt	10$
	mov	r0,vdlist
newgam:	mov	#point!int7,r2
	mov	#stars,r3
12$:	mov	r2,(r3)+
	mov	#8.,r5		;8 stars of each intensity
14$:	jsr	pc,random
				;this algorithm will be repeated.
	asr	r1		;first get rid of non-random bit
	mov	r1,r0
	asr	r0
	asr	r0
	sub	r0,r1		;now r1 has 0.75 of original value
	asr	r1
	asr	r1
	asr	r1
	asr	r1
	asr	r1		;then divide by 32
				;this results in a random number
				;between +/-577 (octal)
	add	#midlx,r1
	bic	#^c<maxx>,r1
	bis	#intx,r1
	mov	r1,(r3)+
	jsr	pc,random
	asr	r1
	mov	r1,r0
	asr	r0
	asr	r0
	sub	r0,r1
	asr	r1
	asr	r1
	asr	r1
	asr	r1
	asr	r1
	add	#midly,r1
	bic	#^c<maxx>,r1
	mov	r1,(r3)+
	dec	r5
	bgt	14$
	sub	#200,r2		;one intensity step
	cmp	r2,#<point!int2>	;minimum intensity
	bge	12$
	mov	vdlist,r0
	clr	switch
	mov	ships,r5	;player count
	mov	#dataaz+70,r3
16$:	mov	#<"99>,-34.(r3)	;initialze torpedoes
	mov	#99.,(r3)+
	clr	(r3)		;torpedoe tube timer
	mov	-68.(r3),12(r3)
	add	#24,r3
	mov	#4,r4
18$:	add	rseed,(r3)
	bic	#177600,(r3)+
	dec	r4
	bgt	18$
	mov	r3,r2
	add	#-94.,r2
	mov	#4,r4
20$:	mov	(r2)+,(r3)+
	dec	r4
	bgt	20$
	clr	(r3)+		;ship id = 0
	mov	r0,(r3)+
	mov	#djmp,(r0)+
	mov	r3,(r0)+	;connect to dlist
	mov	r3,r2
	mov	#point,(r2)+	;generate ship's location
	clr	(r2)+
	clr	(r2)+
	mov	#shortv!int6,(r2)+
	clr	(r2)+		;torpedoe tube
	clr	(r2)+
	mov	#<shortv!int6!blkon>,(r2)+
	clr	(r2)+		;jet
	mov	#<shortv!int7!blkoff>,(r2)+
	mov	r3,r1
	add	#-61.,r1
22$:	mov	#intx,(r2)+
	tstb	(r1)+		;generate area for ship outline
	beq	24$
	bpl	22$
				;	0 end of list
				;	+ intensify
				;	- don't intensify
	clr	-2(r2)
	br	22$
24$:	mov	#djmp,-2(r2)
	mov	r0,(r2)		;connect back to dlist
	mov	r0,-(sp)
	mov	r5,-(sp)
	mov	-30.(r3),r0	;get the initial angle
	jsr	pc,rotate	;rotate the ship to match
	mov	(sp)+,r5
	mov	(sp)+,r0
	add	#174,r3		;next ship
	dec	r5
	bgt	16$
	mov	r0,dataah
	mov	#go,r3
	mov	comets,r5	;comet count
	bgt	26$
	jmp	42$		;none?
26$:	mov	r0,-(sp)
28$:	mov	#4,r4
30$:	clr	(r3)+		;initialize velocity
	dec	r4
	bgt	30$
	mov	#2,r2
32$:	jsr	pc,random
	asr	r1
	mov	r1,(r3)+	;initialize position
	clr	(r3)+
	dec	r2
	bgt	32$
	jsr	pc,random
	mov	#2,(r3)+	;comet id = 2
	mov	(sp)+,r0
	mov	r0,(r3)+
	mov	#djmp,(r0)+
	mov	r3,(r0)+	;connect to dlist
	mov	r0,-(sp)
	mov	r5,-(sp)
	mov	r3,-(sp)
	mov	#point,(r3)+
	clr	(r3)+
	clr	(r3)+
	mov	#shortv,(r3)+
	mov	(pc)+,(r3)+
	gt$rel	-7,-15
	mov	#char!int5,(r3)+
	mov	#<'*>,(r3)+
	mov	#djmp,(r3)+
	mov	r0,(r3)+	;connect back to dlist
	mov	(sp),r3
	jsr	pc,tstsun	;generated in sun?
	bgt	34$
	mov	(sp)+,r3
	br	38$		;if already hit by sun, don't bother
				;(what about dlist?)
34$:	jsr	pc,subaak
	mov	r1,r4
	mov	#1000,r0
	clr	r1
	jsr	pc,divide
	clc
	ror	r1
	adc	r1
	mov	r1,-(sp)
				;comet size?
	mov	sunmas,r4
	jsr	pc,subaah
	asr	r0
	ror	r1
	jsr	pc,subaak
	mov	r1,r0
	mov	(sp)+,r1
	mov	r0,-(sp)
	mov	2(sp),r3
	mov	-8.(r3),r4
	neg	r4
	mov	-12.(r3),r5
	jsr	pc,subaag
	mul32	r0,r1
	mul32	r2,r3
	asl	r1
	adc	r0
	asl	r3
	adc	r2
	mov	r0,r4
	mov	r2,r5
	mov	(sp)+,r1
	jsr	pc,subaag
	div32	r0,r1
	div32	r2,r3
	tst	rseed
	bpl	36$
	neg	r0
	neg	r2
	neg	r1
	sbc	r0
	neg	r3
	sbc	r3
36$:	mov	(sp)+,r4
	mov	r1,-18.(r4)
	mov	r3,-14.(r4)
	mov	r4,r3
	mov	r0,-20.(r3)
	mov	r2,-16.(r3)
38$:	add	#34,r3
	mov	(sp)+,r5
	dec	r5
	ble	40$
	jmp	28$
40$:	mov	(sp)+,r0
42$:	mov	r0,fdlist	;point to free part of dlist
	mov	r3,fspace	;and space for matching dfiles
	mov	#30.,r5		;generate some null dlist entries
44$:	mov	#djmp,(r0)+
	tst	(r0)+
	mov	r0,-2(r0)	;insert null pointer
	dec	r5
	bgt	44$
	mov	#dnop,(r0)+	;non-djmp to allow end of dlist test
	mov	#djmp,(r0)+
	mov	#dfile,(r0)	;link back to start
;
; now get to work.  all dfiles generated at this point, so
; startup display may be run.
;
	mov	#intclx,@#lkv	;connect startup clock
	mov	#br6,@#lkv+2
	mov	#intdsx,@#gtstpv ;and startup display processor
	mov	#br2,@#gtstpv+2
	mov	#ticks,tictoc
	movb	#<'3>,cntdwn	;countdown from here
	mov	vdlist,r0	;want to put a special dfile in here
	mov	#djmp,(r0)+
	mov	(r0),-(sp)	;so we take out the normal one
	mov	#dfilex,(r0)	;and insert our own (first)
	mov	#<statsa!sinof!ital0!sync>,dfilex
	mov	#dfilex,@#dpc	;and start the display
	mov	#100,@#lks	;and then the clock
46$:	wait			;wait for count-down to finish
	tst	dfilex
	bne	46$
	mov	vdlist,r0	;all finished.  so, we can now put
	mov	#djmp,(r0)+	;the normal first dlist entry back
	mov	(sp)+,(r0)	;in (it was saved you know)
	mov	#1,tictoc	;quick kick for generation of ships
	mov	#intclk,@#lkv	;normal clock
	mov	#intdst,@#gtstpv ;and display processor
	mov	#<statsa!sinof!lplite!ital0!sync>,dfile
	mov	ships,surviv	;they are all still alive!
	clr	dataaq
	mov	#dfile,@#dpc	;all ready, so start display
	mov	#100,@#lks	;and clock
48$:	wait
	cmp	surviv,#1	;only 1 surviver?
	bgt	48$		;no. more than one.
	blt	50$		;maybe they are all dead
	cmp	ships,#1	;did we only start off with one?
	beq	48$		;yes. carry on
50$:	tst	dataaq
	bgt	48$
	mov	#intdsx,@#gtstpv ;put the startup display file back in
	clr	@#lks		;and stop the clock
	com	dfilex		;make a halt?
	mov	#dstop,dfile
52$:	wait
	tst	dfilex
	bne	52$
	tst	surviv		;were there any survivors at all?
	ble	56$		;no.
	mov	vdlist,r0	;lets find the surviver
54$:	tst	(r0)+		;skip "djmp"
	mov	(r0)+,r3
	cmp	r0,r3		;null djmp?
	beq	54$		;yes.  this one got wiped
	inc	-44.(r3)	;survived. assumed to be ship.
	mov	-44.(r3),r1	;get the upped score
	mov	#-84.,r2	;and where to display it
	add	r3,r2
	mov	#6,r5		;and the number of digits
	jsr	pc,$print	;and print it all out
56$:	jmp	newgam		;now let someone else play
	.page
intclk:	mov	@#swr,switch	;switch register buffer
	dec	tictoc
	bgt	10$
	jsr	r5,subaaa
	.word	br3,	zaaafm
10$:	rti
;
; if pre-interrupt priority .ge. test val then return,
; else set to higher priority and jump to routine.
; requires 2 arguments -
;	1. test priority
;	2. routine address
;
subaaa:	clr	-(sp)
	mov	6(sp),(sp)	;interrupt priority on stack
	bic	#^c<br7>,(sp)
	cmp	(sp)+,(r5)+	;is it too low?
	bge	10$		;no
	mov	-2(r5),@#ps	;yes. set higher
	mov	(r5),r5		;and make jump
	rts	r5
10$:	tst	(r5)+
	rts	r5
zaaafm:	mov	#3,tictoc
	mov	r0,-(sp)
	mov	r1,-(sp)
	mov	r2,-(sp)
	mov	r3,-(sp)
	mov	r4,-(sp)
	mov	r5,-(sp)
	mov	vdlist,r2
10$:	cmp	(r2)+,#djmp	;end of djmp list?
	bne	40$		;yes.
	mov	(r2)+,r3
	cmp	r3,r2		;ignore null djmps. (somebody got wiped)
	beq	10$
	mov	r2,-(sp)
	movb	-4(r3),r2
	tstb	-3(r3)		;is body dying?
	beq	20$
	add	#6,r2
20$:	jsr	pc,@30$(r2)
	mov	(sp)+,r2
	br	10$		;try for next on list
30$:	.word	subaas		;still surviving ships,
	.word	subaat		;comets
	.word	subaau		;and torpedoes
	.word	subaav		;these are the dying ones.
	.word	subaaw
	.word	subaax
40$:	mov	(sp)+,r5
	mov	(sp)+,r4
	mov	(sp)+,r3
	mov	(sp)+,r2
	mov	(sp)+,r1
	mov	(sp)+,r0
	jsr	r5,subaaa
	.word	br2,	zaaafn
	rti
; ship
subaav:	cmpb	-3(r3),#1
	beq	zaaaay
	cmpb	-3(r3),#-64.
	beq	zaaaay
	incb	-3(r3)
	bmi	zaaaaz
	beq	zaaadb
	cmpb	-3(r3),#64.
	beq	zaaadc
	mov	#databd,r4
	mov	#10,r0
zaaabc:	bitb	#1,-3(r3)
	bne	zaaaay
	mov	#10,r5
	add	r3,r5
zaaadd:	add	(r4)+,(r5)+
	tst	(r5)+
	dec	r0
	bgt	zaaadd
	bitb	#6,-3(r3)
	bne	zaaaay
	sub	#200,6(r3)
zaaaay:	jmp	subaat
zaaadc:	jsr	r5,subaaf
	.byte	-64.
	.even
	br	zaaaaz
zaaadb:	tstb	-41.(r3)
	beq	zaaaba
	decb	-3(r3)
	br	zaaaaz
zaaaba:	dec	dataaq
zaaabb:	mov	-2(r3),r4	;dfile's entry in dlist
	add	#4,r4
	mov	r4,-2(r4)	;disconnect dfile
zaaaaz:	rts	pc
; comet
subaaw:	cmpb	-3(r3),#1
	beq	zaaaay
	incb	-3(r3)
	cmpb	-3(r3),#64.
	beq	zaaabb
	mov	#databd+40,r4
	mov	#4,r0
	br	zaaabc
; torp
subaau:	dec	-22.(r3)
	bgt	10$		;torpedoe still active?
	incb	-3(r3)		;about time too.
	mov	#<point!int7>,(r3)
10$:	jmp	positn
; torp
subaax:	incb	-3(r3)
	cmpb	-3(r3),#32.	;have we died away yet?
	bgt	20$
	bitb	#3,-3(r3)	;time to fade a bit more?
	bne	10$
	sub	#200,(r3)	;down 1 brightness level
10$:	jmp	positn
20$:	mov	-24.(r3),r4	;tell parent space-ship that we
	decb	-41.(r4)	;finally died away
	br	zaaabb
; ship
subaas:	dec	-40.(r3)	;how long since torpedoe was fired?
	bgt	10$		;not long enough
	clr	-40.(r3)	;it should be loaded by now
	tstb	-42.(r3)	;unless of cource we are out of
	beq	10$		;torpedoes.
	bis	#intx,10(r3)	;intensify torpedoes
10$:	mov	-110.(r3),-(sp)	;get this guy's switch register mask
	clr	r0		;initialize turn angle
	bit	(sp),switch	;calculate turning movement
	beq	15$
	add	omega,r0	;turn counter-clockwise
15$:	clc
	ror	(sp)
	bit	(sp),switch
	beq	20$
	sub	omega,r0	;turn clockwise
20$:	tst	r0
	beq	22$
	add	-30.(r3),r0
	mov	r0,-30.(r3)
	jsr	pc,rotate	;and rotate ship to match
	br	25$
22$:	bit	(sp),switch
	bne	24$
	bis	#1400,20(r3)
	br	25$
24$:	bic	#1400,20(r3)
25$:	asr	(sp)
	bit	(sp),switch	;any thrust?
	beq	30$		;no
				;increase velocities
	add	-26.(r3),-18.(r3)
	adc	-20.(r3)
	add	-22.(r3),-14.(r3)
	adc	-16.(r3)
	add	-28.(r3),-20.(r3)
	add	-24.(r3),-16.(r3)
	bis	#intx,16(r3)	;intensify jet
	br	35$
30$:	bic	#intx,16(r3)	;no thrust - turn jet off
35$:	asr	(sp)
	bit	(sp),switch	;firing torpedoes?
	beq	50$		;no
	bit	#intx,10(r3)	;is there one in tube yet?
	beq	50$		;no
	cmpb	-41.(r3),#15.	;yes. but can only remotely control
	bge	50$		;a limited number
	mov	fdlist,r4	;now look for a free dfile to
				;generate the torpedoe in
40$:	cmp	(r4)+,#djmp	;end of dlist?
	bne	50$		;yes. no slots available
	mov	(r4)+,r5
	cmp	r5,r4		;is this slot already full?
	bne	40$		;yes. can't use
	bic	#intx,10(r3)	;turn off torpedoe tube glow
	mov	#15.,-40.(r3)	;no more torpedoes for this long
	incb	-41.(r3)	;now this ship owns 1 more active torp.
	mov	r3,-(sp)
	sub	#4,r4
	mov	r4,r5
	sub	fdlist,r5	;calculate where the dfile goes
	asl	r5
	asl	r5
	asl	r5
	asl	r5		;each chunk is 64. bytes long
	add	fspace,r5
	mov	r3,(r5)+
	mov	#150.,(r5)+	;torpedoe's lifetime
	mov	r3,r0
	add	#-38.,r0
	add	#-20.,r3	;veloc
	mov	#4,r1
45$:	mov	(r3)+,(r5)
	add	(r0)+,(r5)+
				;veloc incr?
	mov	(r3)+,(r5)+
	dec	r1
	bgt	45$
	mov	#4,(r5)+	;torp id = 4
	mov	r4,(r5)+
	mov	r5,r0
	mov	#point!int5,(r5)+
	mov	#<intx!midlx>,(r5)+
	mov	#<midly>,(r5)+
	mov	#djmp,(r5)+
	mov	r4,(r5)		;connect back to dlist
	add	#4,(r5)
	mov	r0,2(r4)	;actually connect to dlist when ready
	mov	(sp)+,r3
	decb	-42.(r3)	;one less torpedoe
	movb	-42.(r3),r1
	mov	r3,r2
	add	#-74.,r2	;display it here
	mov	#2,r5		;digits
	jsr	pc,$print
50$:	tst	(sp)+		;fall thru to comets
subaat:	jsr	pc,tstsun	;collided with sun?
	bgt	10$
	tstb	-3(r3)		;not if we're already dying
	bne	positn
	jsr	r5,subaaf
	.byte	1
	.even
	br	positn		;don't test for other deaths
10$:	mov	r3,-(sp)
	jsr	pc,subaak
	mov	r1,r4
	mov	#stack,r0
	clr	r1
	jsr	pc,divide
	clc
; gravity??????
	ror	r1
	adc	r1
	mov	r1,-(sp)
	mov	-12.(r3),r4
	mov	-8.(r3),r5
	jsr	pc,subaag
	mul32	r0,r1
	mul32	r2,r3
	asl	r1
	adc	r0
	asl	r3
	adc	r2
	mov	(sp)+,r4
	mov	r2,-(sp)
	mov	r0,-(sp)
				;drag in
	mov	sunmas,r1
	neg	r1
	jsr	pc,subaah
	asl	r1
	adc	r0
	mov	r0,r1
	mov	r4,r0
	mov	(sp)+,r4
	mov	(sp)+,r5
	mov	r0,-(sp)
	jsr	pc,subaag
	asl	r1
	adc	r0
	asl	r3
	adc	r2
	mov	r0,r4
	mov	r2,r5
	mov	(sp)+,r1
	jsr	pc,subaag
	div32	r0,r1
	asr	r0
	ror	r1
	div32	r2,r3
	asr	r2
	ror	r3
	mov	(sp)+,r4	;add accel
	add	r1,-18.(r4)
	adc	-20.(r4)
	add	r3,-14.(r4)
	adc	-16.(r4)
	mov	r4,r3
	add	r0,-20.(r3)
	add	r2,-16.(r3)
				;update position
positn:	add	-18.(r3),-10.(r3)
	adc	-12.(r3)
	add	-14.(r3),-6.(r3)
	adc	-8.(r3)
	mov	-20.(r3),r0
	add	-12.(r3),r0
	rol	r0
	asr	r0
	mov	r0,-12.(r3)
	neg	r0
	asr	r0
	asr	r0
	add	-12.(r3),r0
	add	#<midlx*32.>,r0
	asr	r0
	asr	r0
	asr	r0
	asr	r0
	asr	r0
	adc	r0		;round it up
	bic	#^c<maxx>,r0	;don't want intensity bit trouble
	bic	#<maxx>,2(r3)
	bis	r0,2(r3)	;update the dfile x position
	mov	-16.(r3),r0
	add	-8.(r3),r0
	rol	r0
	asr	r0
	mov	r0,-8.(r3)
	neg	r0
	asr	r0
	asr	r0
	add	-8.(r3),r0
	add	#<midly*32.>,r0
	asr	r0
	asr	r0
	asr	r0
	asr	r0
	asr	r0
	adc	r0		;round up
	bic	#^c<maxx>,r0
	mov	r0,4(r3)	;update dfile y position
	rts	pc
rotate:	add	#400,r0		;round upwards
	mov	r0,r1
	swab	r1
	bic	#^c<76>,r1	;get 5 low order bits of 7 bit angle
	asl	r1		;and select double word
	rol	r0
	rol	r0
	rol	r0
	rol	r0
