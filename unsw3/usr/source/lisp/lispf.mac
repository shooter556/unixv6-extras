
	.list
	.title	unix
	.ident	/v002/
.hiseg

; unix interface
	global	<.nil,ccflag,bitend,unxbuf>
$exit	=	trap+1.
$open	=	trap+5.
$close	=	trap+6.
$sig	=	trap+48.
$read	=	trap+3.
$write	=	trap+4.
$unlink	=	trap+10.
$creat	=	trap+8.
$fork	=	trap+2.
$indir	=	trap+0.
$exec	=	trap+11.
$wait	=	trap+7.
$break	=	trap+17.
$seek 	=	trap+19.


; flag defs

open = 200
input = 100

	entry	exit
	$exit

	entry	gopen
	$sig
	+	2
	+	intr
	$sig
	+	3
	+	quit
	mov	#2,r0
	$close
	$open
	+	errfil
	+	0
	setd
	reti

intr:	mov	r0,-(sp)	;be neat
	$sig
	+	2
	+	intr
	mov	(sp)+,r0	;restore
	inc	ccflag
	rti			;exit

quit:	mov	r0,-(sp)	;be neat
	$sig
	+	3
	+	quit
	mov	(sp)+,r0	;restore
	mov	#-1000.,ccflag
	rti

	entry	ed
	mov	#bined,sys+2
	calli	filnam
	mov	#unxbuf,arg+2
	mov	#arg,sys+4
	br newp

	entry	fork
	mov	#nm,sys+2
	mov	#al,sys+4

newp:	$sig
	+	2
	+	1
	$sig
	+	3
	+	1
	$fork
		br 1$
	mov	r0,-(sp)
2$:	$wait
	cmp	r0,(sp)
	bne	2$
	tst	(sp)+
	$sig
	+	2
	+	intr
	$sig
	+	3
	+	quit
	reti
1$:	$indir
	+	sys
	$exit

	entry	openi
	calli	fslot
	calli	filnam
	$open
	+	unxbuf
	+	0
	bcs	generr
	movb	#open+input,fmd(r1)
opn2:	movb	r0,fds(r1)
	movb	r1,r0
	mov	(sp)+,r1
	reti

	entry	openo
	calli	fslot
	calli	filnam
	$creat
	+	unxbuf
	+	644
	bcs	generr
	movb	#open,fmd(r1)
	br	opn2

	entry	delete
	calli	filnam
	$unlink
	+	unxbuf
	reti

fslot:	mov	r1,-(sp)
	clr	r1
2$:	tstb	fmd(r1)
	bpl	1$
	inc	r1
	cmp	#nfiles-1,r1
	bhis	2$
	mov	(sp)+,r1
	inc	(sp)+
	reti
1$:	mov	2(sp),-(sp)
	mov	2(sp),4(sp)
	mov	(sp)+,(sp)
	reti

filnam:	mov	r2,-(sp)
	mov	r3,-(sp)
	mov	#unxbuf,r2
	mov	r0,r3
1$:	cmp	r3,.nil
	beq	4$
	mov	2(r3),(r2)+
	mov	(r3),r3
	cmp	r3,#1
	beq	3$
	cmp	r2,#unxbuf+68.
	blo	1$
4$:	clrb	(r2)+
	mov	(sp)+,r3
	mov	(sp)+,r2
	reti
3$:	dec	r2
	br	4$

	entry	ochan
	cmp	r0,#nfiles
	bhis	errxxx
	tstb	fmd(r0)
	bpl	errxxx
	bitb	#input,fmd(r0)
	bne	errxxx
	movb	r0,ochn
	reti

	entry	ichan
	cmp	r0,#nfiles
	bhis	errxxx
	tstb	fmd(r0)
	bpl	errxxx
	bitb	#input,fmd(r0)
	beq	errxxx
	movb	r0,ichn
	reti

generr:	mov	(sp)+,r1
errxxx:	sec
	reti

	entry	close
	cmp	r0,#nfiles
	bhis	errxxx
	tstb	fmd(r0)
	bpl	errxxx
	clrb	fmd(r0)
	movb	fds(r0),r0
	$close
	reti

	entry	cbuff
	mov	r0,-(sp)
1$:	calli	getc
	bcs	3$
	cmpb	r0,#7		;bell??
	bne	1$
3$:	mov	(sp)+,r0
	reti

	entry	newlin
	mov	r0,-(sp)
	callc	putc	#12
	mov	(sp)+,r0
	reti

	entry	ibuff
	movb	r0,ibfc
	incb	ibff
	reti

	entry	rnonul
	calli	peekc
	bcs	1$
	cmpb	r0,#' 
	beq	2$
	cmpb	r0,#'	
	beq	2$
	cmpb	r0,#12
	bne	3$
2$:	calli	getc
	br	rnonul
3$:	clc
1$:	reti

	entry	sin
	mov	r0,ilnk
	add	#2,ilnk
	mov	#4,icnt
	movb	#-1,ichn
	reti

	entry	sout
	mov	r0,olnk
	add	#2,olnk
	mov	#4,ocnt
	movb	#-1,ochn
	reti

	entry	getcore
	add	bitend,r0
	bcs	1$
	mov	r0,bkx+2
	$indir
	+	bkx
	bcs	1$
	mov	bitend,r0
	mov	bkx+2,bitend
1$:	reti

	entry	msgfil
	mov	r1,-(sp)
	mov	r0,r1
	mul	#64.,r1
	mov	r1,msg+2
	mov	#2,r0
	$indir
	+	msg
	$read
	+	unxbuf
	+	64.
	mov	(sp)+,r1
	reti

	entry	msgout
	mov	#1,r0
	movb	unxbuf,otx+4
	$indir
	+	otx
	reti

	entry	putc
	mov	r0,-(sp)
	movb	r0,oc
	movb	ochn,r0
	bmi	1$
	movb	fds(r0),r0
	$write
	+	oc
	+	1
2$:	mov	(sp)+,r0
	clc
	reti

1$:	mov	olnk,r0
	cmp	ocnt,#4
	bne	3$
	mov	#sysreg+4,-(sp)
	call	gnode
	tst	(sp)+
	mov	(sp),(r0)
	mov	(sp)+,r0
	mov	r0,olnk
	mov	#1,(r0)
	mov	#2,ocnt
	tst	(sp)+

3$:	cmp	ocnt,#3
	bne	4$
	mov	.nil,(r0)

4$:	mov	r0,-(sp)
	add	ocnt,(sp)
	movb	oc,@(sp)+
	inc	ocnt
	br	2$

	entry	getc
	tstb	ibff
	beq	1$
	movb	ibfc,r0
	clrb	ibff
	reti

1$:	movb	ichn,r0
	tstb	fbc(r0)
	bne	2$
	calli	filbuf

2$:	tstb	fbc(r0)
	beq	fret
	movb	fc1(r0),-(sp)
	movb	fc2(r0),fc1(r0)
	decb	fbc(r0)
	movb	(sp)+,r0
	reti

	entry	peekc
	tstb	ibff
	beq	1$
	movb	ibfc,r0
	reti

1$:	movb	ichn,r0
	tstb	fbc(r0)
	bne	2$
	calli	filbuf

2$:	tstb	fbc(r0)
	beq	fret
	movb	fc1(r0),r0
	reti

fret:	sec
	reti

	entry	peek2
	movb	ichn,r0
	cmpb	fbc(r0),#2
	beq	1$
	tstb	fbc(r0)
	bne	2$
	calli	filbuf
	tstb	fbc(r0)
	beq	fret
2$:	calli	filbuf
	cmpb	fbc(r0),#2
	bne	fret
1$:	movb	fc2(r0),r0
	reti

filbuf:	mov	r0,-(sp)

4$:	mov	r0,flx+2
	tstb	fbc(r0)
	bne	2$
	add	#fc1-fc2,flx+2
2$:	add	#fc2,flx+2
	movb	fds(r0),r0
	bmi	3$
	$indir
	+	flx
	bcs	1$
	tst	r0
	bne	7$
	tst	(sp)
	bne	1$
	$exit
7$:	mov	(sp),r0
	incb	fbc(r0)
	br	1$

3$:	mov	ilnk,r0
	cmp	icnt,#4
	bne	5$
	cmp	r0,.nil
	beq	1$
	mov	(r0),r0
	mov	r0,ilnk
	cmp	r0,.nil
	beq	1$
	mov	#2,icnt

5$:	cmp	icnt,#3
	bne	6$
	cmp	(r0),#1
	beq	1$

6$:	mov	r0,-(sp)
	add	icnt,(sp)
	movb	@(sp)+,@flx+2
	inc	icnt
	br	7$

1$:	mov	(sp)+,r0
	reti

.loseg

sys:	$exec
	+	0
	+	0
bkx:	$break
	+	0

flx:	$read
	+	0
	+	1

otx:	$write
	+	unxbuf+1
	+	0

msg:	$seek
	+	0
	+	0

al:	.word minus,0
minus:	asciz	<->
nm:	asciz	</bin/sh>
bined:	asciz	</bin/ed>
arg:	.word eda,0,0
eda:	asciz	<ed>
errfil:	asciz	<lisp.err>
	.even

ilnk:	.blkw
olnk:	.blkw
ccflag:	.blkw

unxbuf:	.blkb	70.

ocnt:	.blkw
icnt:	.blkw
ibff:	.blkb
ibfc:	.blkb
ochn:	.blkb
ichn:	.blkb
oc:	.blkb

	.blkb
fc1:	.blkb	nfiles

	.blkb
fc2:	.blkb	nfiles

	.blkb
fbc:	.blkb	nfiles

	.byte	-1
fds:	.byte	0
	.byte	1
	.blkb	nfiles-2

	.byte	open
fmd:	.byte	open+input
	.byte	open
	.blkb	nfiles-2

	.end
