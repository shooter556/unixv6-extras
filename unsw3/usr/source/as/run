echoall
	/bin/as -o as1.o as1?.s
	/bin/as -o as2.o as2?.s
	ld -o as1 -n -s as1.o
	chmod 111 /bin/as; /bin/as; rm -f /bin/as
	mv as1 /bin/as ; chown root /bin/as ; chmod 1711 /bin/as
	ld -o as2 -n -s as2.o
	chmod 111 /lib/as2; /lib/as2; rm -f /lib/as2
	mv as2 /lib/as2 ; chown root /lib/as2 ; chmod 1711 /lib/as2
	rm *.o a.out
exit
